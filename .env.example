# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION - AHMAD MEIJLAN YASIR PORTFOLIO
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk development lokal, atau masukkan
# variabel-variabel ini ke Environment Variables dashboard hosting Anda (Vercel, dll).
#
# PENTING TENTANG KEAMANAN (SECURITY):
# - Variabel berawalan `NEXT_PUBLIC_` akan dibundel ke JavaScript browser (DAPAT DIBACA PUBLIK).
# - Variabel TANPA awalan `NEXT_PUBLIC_` adalah SERVER-SIDE ONLY (AMAN DARI LEAK / BROWSING).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & BACKEND (SUPABASE)
# ------------------------------------------------------------------------------
# Dapatkan kredensial ini di Dashboard Supabase -> Project Settings -> API

# URL Project Supabase (Aman dibaca publik)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key Supabase (Aman dibaca publik, DILINDUNGI Row Level Security / RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# KUNCI RAHASIA ADMIN SUPABASE (SERVER-SIDE ONLY)
# PERINGATAN KERAS: JANGAN PERNAH gunakan prefiks NEXT_PUBLIC_ untuk kunci ini!
# Service role key memiliki hak penuh untuk bypass RLS dan mengubah seluruh database.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# ------------------------------------------------------------------------------
# 2. EMAIL & CONTACT FORM (EMAILJS)
# ------------------------------------------------------------------------------
# Kredensial EmailJS diproses 100% dari backend (/api/contact) sehingga tidak bocor
# ke browser pengunjung dan terlindungi dari bot spammer / quota abuse.
# Dapatkan di https://dashboard.emailjs.com/

# Service ID dari Email Services di EmailJS (contoh: service_portfolio)
EMAILJS_SERVICE_ID=service_xxxxxxx

# Template ID dari Email Templates di EmailJS (contoh: template_contact)
EMAILJS_TEMPLATE_ID=template_xxxxxxx

# Public Key / Account ID dari Account Settings di EmailJS
EMAILJS_PUBLIC_KEY=user_xxxxxxxxxxxxxxxx

# (Wajib untuk pengiriman dari Server / Vercel + Sangat Direkomendasikan)
# Private Key / Access Token EmailJS — lihat Dashboard EmailJS -> Account -> Security:
# 1. AKTIFKAN "Allow EmailJS API for non-browser applications" (wajib karena dikirim dari server /api/contact).
# 2. Salin Private Key ke EMAILJS_PRIVATE_KEY di bawah agar request luar server ditolak.
EMAILJS_PRIVATE_KEY=your_emailjs_private_access_token_here

# Catatan Kompatibilitas:
# Jika Anda sebelumnya menggunakan NEXT_PUBLIC_EMAILJS_*, sistem backend
# tetap dapat membacanya sebagai fallback, namun disarankan menggunakan format di atas.


# ------------------------------------------------------------------------------
# 3. AI CHATBOT ASSISTANT (GOOGLE GEMINI 3.5 FLASH-LITE)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/
# Kunci ini diproses di server endpoint (/api/chat) yang dilindungi rate limiter.

GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opsional) Model ID Gemini yang digunakan oleh chatbot (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite


# ------------------------------------------------------------------------------
# 4. SYSTEM SECURITY & ANTI-SPAM SALT
# ------------------------------------------------------------------------------
# String rahasia acak untuk menandatangani cryptographic HMAC token verifikasi matematika
# pada formulir kontak untuk mencegah pemalsuan CAPTCHA oleh bot script.

SECURITY_SECRET=generate_any_random_32_character_string_here_for_hmac_salt


# ------------------------------------------------------------------------------
# 5. DOMAIN & CANONICAL URL
# ------------------------------------------------------------------------------
# Domain resmi website portfolio Anda

NEXT_PUBLIC_SITE_URL=https://amymeij.web.id
